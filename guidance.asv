function [chi_des] = guidance(nu,waypoint)

    %data
    y = nu(2);
    y_ref = waypoint(2);
    x_ref = waypo
    y_err = y - y_ref; 
    x_err = x - x_ref

    pi_h = atan2( x - x_ref);    %path tangential angle
    y_cross =  sin(pi_h)*                               %cross track error
    chi_d = pi_h - atan()
    
end